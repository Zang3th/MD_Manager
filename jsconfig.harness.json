{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests/**/*.js",
    "tools/**/*.js",
    ".codex/skills/**/*.js",
    "types/harness.d.ts",
    "playwright.config.js",
    "eslint.config.js"
  ],
  "exclude": ["vendor", "node_modules", "playwright-report", "test-results", "ai-blueprint"]
}
